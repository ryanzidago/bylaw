#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "$0")/.." && pwd)"
fixture_root="$(mktemp -d)"
trap 'rm -rf "$fixture_root"' EXIT HUP INT TERM

mkdir "$fixture_root/bin"

cat >"$fixture_root/bin/git" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "symbolic-ref" ]]; then
  printf '%s\n' "${CURRENT_BRANCH:-main}"
  exit 0
fi

exit 1
EOF

chmod +x "$fixture_root/bin/git"

if PATH="$fixture_root/bin:$PATH" \
  CURRENT_BRANCH=main \
  "$repository_root/scripts/reject-main" 2>/dev/null; then
  echo "expected commits from main to be rejected" >&2
  exit 1
fi

PATH="$fixture_root/bin:$PATH" \
  CURRENT_BRANCH=feature \
  "$repository_root/scripts/reject-main"

if printf '%s\n' \
  "refs/heads/feature local-feature refs/heads/main remote-main" |
  PATH="$fixture_root/bin:$PATH" \
    CURRENT_BRANCH=feature \
    "$repository_root/scripts/reject-main-push" 2>/dev/null; then
  echo "expected direct pushes to main to be rejected" >&2
  exit 1
fi

printf '%s\n' \
  "refs/heads/feature local-feature refs/heads/feature remote-feature" |
  PATH="$fixture_root/bin:$PATH" \
    CURRENT_BRANCH=feature \
    "$repository_root/scripts/reject-main-push"

if printf '%s\n' \
  "refs/heads/feature local-feature refs/heads/feature remote-feature" |
  PATH="$fixture_root/bin:$PATH" \
    CURRENT_BRANCH=main \
    "$repository_root/scripts/reject-main-push" 2>/dev/null; then
  echo "expected pushes initiated from main to be rejected" >&2
  exit 1
fi

echo "Main branch guard tests passed."
