#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "$0")/.." && pwd)"
fixture_root="$(mktemp -d)"
trap 'rm -rf "$fixture_root"' EXIT HUP INT TERM

mkdir "$fixture_root/bin"

cat >"$fixture_root/bin/git" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "-C" ]]; then
  primary="$2"
  shift 2
  case "${1:-}" in
    rev-parse | fetch) exit 0 ;;
    merge)
      cd "$primary"
      "$POST_MERGE_HOOK"
      printf '%s\n' finished >"$SWITCH_LOG"
      exit 0
      ;;
  esac
fi

if [[ "${1:-}" == "symbolic-ref" ]]; then
  printf '%s\n' "${CURRENT_BRANCH:-main}"
  exit 0
fi

exit 1
EOF

cat >"$fixture_root/bin/wt" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

if [[ "${WT_UNAVAILABLE:-0}" == "1" ]]; then
  exit 1
fi

for argument in "$@"; do
  case "$argument" in
    list)
      cat "$WT_FIXTURE"
      exit 0
      ;;
    remove)
      printf '%s\n' "$*" >>"$REMOVE_LOG"
      if [[ -n "${SWITCH_PID:-}" && "$*" == *"--reap /repo/merged-clean"* ]]; then
        kill -TERM "$SWITCH_PID"
      fi
      exit 0
      ;;
  esac
done

exit 1
EOF

cat >"$fixture_root/bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' called >>"$GH_LOG"

if [[ "${GH_UNAVAILABLE:-0}" == "1" ]]; then
  exit 1
fi

cat "$PR_FIXTURE"
EOF

chmod +x "$fixture_root/bin/git" "$fixture_root/bin/wt" "$fixture_root/bin/gh"

cat >"$fixture_root/worktrees.json" <<'EOF'
[
  {
    "kind": "worktree",
    "is_main": true,
    "branch": "main",
    "path": "/repo"
  },
  {
    "kind": "worktree",
    "is_main": false,
    "branch": "merged-clean",
    "path": "/repo/merged-clean",
    "working_tree": {
      "staged": false,
      "modified": false,
      "untracked": false,
      "renamed": false,
      "deleted": false
    }
  },
  {
    "kind": "worktree",
    "is_main": false,
    "branch": "merged-dirty",
    "path": "/repo/merged-dirty",
    "working_tree": {
      "staged": false,
      "modified": true,
      "untracked": false,
      "renamed": false,
      "deleted": false
    }
  },
  {
    "kind": "worktree",
    "is_main": false,
    "branch": "closed-clean",
    "path": "/repo/closed-clean",
    "working_tree": {
      "staged": false,
      "modified": false,
      "untracked": false,
      "renamed": false,
      "deleted": false
    }
  },
  {
    "kind": "worktree",
    "is_main": false,
    "branch": "open-pr",
    "path": "/repo/open-pr",
    "working_tree": {
      "staged": false,
      "modified": false,
      "untracked": false,
      "renamed": false,
      "deleted": false
    }
  },
  {
    "kind": "worktree",
    "is_main": false,
    "branch": "reopened-pr",
    "path": "/repo/reopened-pr",
    "working_tree": {
      "staged": false,
      "modified": false,
      "untracked": false,
      "renamed": false,
      "deleted": false
    }
  },
  {
    "kind": "worktree",
    "is_main": false,
    "branch": "no-pr",
    "path": "/repo/no-pr",
    "working_tree": {
      "staged": false,
      "modified": false,
      "untracked": false,
      "renamed": false,
      "deleted": false
    }
  }
]
EOF

cat >"$fixture_root/prs.json" <<'EOF'
[
  {"headRefName": "merged-clean", "state": "MERGED"},
  {"headRefName": "merged-dirty", "state": "MERGED"},
  {"headRefName": "closed-clean", "state": "CLOSED"},
  {"headRefName": "open-pr", "state": "OPEN"},
  {"headRefName": "reopened-pr", "state": "CLOSED"},
  {"headRefName": "reopened-pr", "state": "OPEN"}
]
EOF

: >"$fixture_root/removed"
: >"$fixture_root/gh-calls"

PATH="$fixture_root/bin:$PATH" \
  WT_FIXTURE="$fixture_root/worktrees.json" \
  PR_FIXTURE="$fixture_root/prs.json" \
  REMOVE_LOG="$fixture_root/removed" \
  GH_LOG="$fixture_root/gh-calls" \
  "$repository_root/scripts/remove-finished-pr-worktrees"

if [[ "$(wc -l <"$fixture_root/removed" | tr -d ' ')" != "2" ]]; then
  echo "expected exactly two finished PR worktrees to be removed" >&2
  cat "$fixture_root/removed" >&2
  exit 1
fi

grep -Fq -- "--foreground --reap /repo/merged-clean" "$fixture_root/removed"
grep -Fq -- "--foreground --reap --no-delete-branch /repo/closed-clean" "$fixture_root/removed"

if grep -Eq "merged-dirty|open-pr|reopened-pr|no-pr" "$fixture_root/removed"; then
  echo "dirty, open, reopened, and unassociated worktrees must be preserved" >&2
  exit 1
fi

if [[ "$(wc -l <"$fixture_root/gh-calls" | tr -d ' ')" != "1" ]]; then
  echo "pull request state should be fetched exactly once" >&2
  exit 1
fi

: >"$fixture_root/removed"
: >"$fixture_root/gh-calls"

PATH="$fixture_root/bin:$PATH" \
  WT_FIXTURE="$fixture_root/worktrees.json" \
  PR_FIXTURE="$fixture_root/prs.json" \
  REMOVE_LOG="$fixture_root/removed" \
  GH_LOG="$fixture_root/gh-calls" \
  GH_UNAVAILABLE=1 \
  "$repository_root/scripts/remove-finished-pr-worktrees"

if [[ -s "$fixture_root/removed" ]]; then
  echo "GitHub failure must preserve every worktree" >&2
  exit 1
fi

: >"$fixture_root/removed"
: >"$fixture_root/gh-calls"

PATH="$fixture_root/bin:$PATH" \
  WT_FIXTURE="$fixture_root/worktrees.json" \
  PR_FIXTURE="$fixture_root/prs.json" \
  REMOVE_LOG="$fixture_root/removed" \
  GH_LOG="$fixture_root/gh-calls" \
  WT_UNAVAILABLE=1 \
  "$repository_root/scripts/remove-finished-pr-worktrees"

if [[ -s "$fixture_root/removed" ]]; then
  echo "Worktrunk failure must preserve every worktree" >&2
  exit 1
fi

: >"$fixture_root/removed"
: >"$fixture_root/gh-calls"

PATH="$fixture_root/bin:$PATH" \
  WT_FIXTURE="$fixture_root/worktrees.json" \
  PR_FIXTURE="$fixture_root/prs.json" \
  REMOVE_LOG="$fixture_root/removed" \
  GH_LOG="$fixture_root/gh-calls" \
  CURRENT_BRANCH=feature \
  "$repository_root/scripts/remove-finished-pr-worktrees"

if [[ -s "$fixture_root/removed" || -s "$fixture_root/gh-calls" ]]; then
  echo "cleanup must only run from the primary branch" >&2
  exit 1
fi

test_active_switch_survives_nested_post_merge_cleanup() {
  local primary="$fixture_root/primary checkout"
  local pre_switch quoted_primary
  mkdir -p "$primary/scripts"
  ln -s "$repository_root/scripts/remove-finished-pr-worktrees" "$primary/scripts/remove-finished-pr-worktrees"
  cat >"$primary/scripts/qa.sh" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' checked >>"$QA_LOG"
EOF
  chmod +x "$primary/scripts/qa.sh"

  pre_switch="$(sed -n 's/^pre-switch = "\(.*\)"$/\1/p' "$repository_root/.config/wt.toml")"
  [[ -n "$pre_switch" ]]
  printf -v quoted_primary '%q' "$primary"
  pre_switch="${pre_switch//\{\{ primary_worktree_path \}\}/$quoted_primary}"
  : >"$fixture_root/removed"
  : >"$fixture_root/gh-calls"

  if ! PATH="$fixture_root/bin:$PATH" \
    WT_FIXTURE="$fixture_root/worktrees.json" \
    PR_FIXTURE="$fixture_root/prs.json" \
    REMOVE_LOG="$fixture_root/removed" \
    GH_LOG="$fixture_root/gh-calls" \
    QA_LOG="$fixture_root/qa-calls" \
    SWITCH_LOG="$fixture_root/switch-finished" \
    POST_MERGE_HOOK="$repository_root/.githooks/post-merge" \
    PRE_SWITCH="$pre_switch" \
    bash -c 'export SWITCH_PID="$$"; eval "$PRE_SWITCH"'; then
    for attempt in {1..50}; do
      [[ -s "$fixture_root/switch-finished" ]] && break
      sleep 0.02
    done
    echo "nested post-merge cleanup terminated the active switch" >&2
    return 1
  fi

  if [[ ! -s "$fixture_root/switch-finished" || ! -s "$fixture_root/qa-calls" ]]; then
    echo "the primary refresh and its QA must finish during the switch" >&2
    return 1
  fi
  if [[ -s "$fixture_root/removed" || -s "$fixture_root/gh-calls" ]]; then
    echo "nested cleanup must preserve all worktrees while switching" >&2
    return 1
  fi
}

test_explicit_switch_context_preserves_all_worktrees() {
  : >"$fixture_root/removed"
  : >"$fixture_root/gh-calls"
  PATH="$fixture_root/bin:$PATH" \
    WT_FIXTURE="$fixture_root/worktrees.json" \
    PR_FIXTURE="$fixture_root/prs.json" \
    REMOVE_LOG="$fixture_root/removed" \
    GH_LOG="$fixture_root/gh-calls" \
    BYLAW_WORKTREE_SWITCH=1 \
    "$repository_root/scripts/remove-finished-pr-worktrees"

  if [[ -s "$fixture_root/removed" || -s "$fixture_root/gh-calls" ]]; then
    echo "explicit switch context must defer cleanup before enumerating worktrees" >&2
    return 1
  fi
}

test_active_switch_survives_nested_post_merge_cleanup
test_explicit_switch_context_preserves_all_worktrees

echo "Finished PR worktree cleanup tests passed."
