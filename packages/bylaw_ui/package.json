{
  "name": "bylaw-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "exports": {
    ".": "./src/index.ts",
    "./playwright": "./src/playwright.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/playwright.ts --outdir ./dist --target bun",
    "check": "bun run typecheck && bun run build && bun test",
    "test": "bun test",
    "test:browser": "bun test test/browser",
    "test:pure": "bun test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "playwright-core": "1.62.0",
    "typescript": "7.0.2"
  }
}
