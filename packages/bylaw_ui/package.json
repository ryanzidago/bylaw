{
  "name": "bylaw-ui",
  "version": "0.1.0",
  "description": "Executable geometric contracts for rendered user interfaces",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanzidago/bylaw.git",
    "directory": "packages/bylaw_ui"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.js"
    }
  },
  "scripts": {
    "build": "bun run clean && bun build ./src/index.ts ./src/playwright.ts --outdir ./dist --target node --format esm && tsc -p tsconfig.build.json",
    "check": "bun run typecheck && bun run build && bun test",
    "clean": "rm -rf ./dist",
    "prepack": "bun run check",
    "test": "bun test",
    "test:browser": "bun test test/browser",
    "test:package": "bun run scripts/test-package-consumption.ts",
    "test:pure": "bun test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "playwright-core": "^1.62.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "playwright-core": "1.62.0",
    "typescript": "7.0.2"
  }
}
